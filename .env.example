# Database
# Development: SQLite (file:./dev.db)
# Production: PostgreSQL (Render managed)
DATABASE_URL="file:./dev.db"

# LLM Provider — NVIDIA NIM (replaces Ollama)
# All models now use NVIDIA API (OpenAI-compatible)
# Get key at https://build.nvidia.com
LLM_PROVIDER="production"
PRODUCTION_LLM_API_KEY=""
PRODUCTION_LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
PRODUCTION_LLM_MODEL="deepseek-ai/deepseek-v4.1-flash"

# Ollama (fallback, local only — not used when LLM_PROVIDER=production)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"

# Tavily API (Web Search) - Required for research
# Get from https://tavily.com
TAVILY_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Future)
AUTH_SECRET=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="60"

# Research Configuration
RESEARCH_TIMEOUT_MS="30000"
RESEARCH_MAX_RETRIES="3"
RESEARCH_CACHE_TTL_HOURS="24"

# GitHub Intelligence (ContextOS-inspired)
# Personal access token for GitHub API (server-only, never NEXT_PUBLIC_, never logs)
# Generate at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=""

# Cache / Redis (optional)
# If REDIS_URL is set, a future Redis provider can be wired; currently in-memory cache mimics Redis
# Cache DB fallback persists to CacheEntry table when true
REDIS_URL=""
CACHE_DB_FALLBACK="false"
# TTLs in milliseconds (env overrides defaults: Tavily 24h, extraction 7d, github 24h, identity 24h, company 24h)
CACHE_TTL_TAVILY_MS="86400000"
CACHE_TTL_EXTRACTION_MS="604800000"
CACHE_TTL_GITHUB_MS="86400000"
CACHE_TTL_IDENTITY_MS="86400000"
CACHE_TTL_COMPANY_MS="86400000"

# LinkedIn Provider (stub — no scraping)
# Placeholder for future licensed API; current stub only normalizes URLs
LINKEDIN_API_KEY=""
