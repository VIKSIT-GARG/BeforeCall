# Database
# Development: SQLite (file:./dev.db)
# Production: PostgreSQL (Render managed)
DATABASE_URL="file:./dev.db"

# Ollama (Local LLM) - Development Only
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"

# Production LLM Provider (OpenAI, Anthropic, etc.)
# Set LLM_PROVIDER=production to use these
LLM_PROVIDER="ollama"
PRODUCTION_LLM_API_KEY=""
PRODUCTION_LLM_MODEL="gpt-4o-mini"
PRODUCTION_LLM_BASE_URL="https://api.openai.com/v1"

# Tavily API (Web Search) - Required for research
# Get from https://tavily.com
TAVILY_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Future)
AUTH_SECRET=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="60"

# Research Configuration
RESEARCH_TIMEOUT_MS="30000"
RESEARCH_MAX_RETRIES="3"
RESEARCH_CACHE_TTL_HOURS="24"