generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  agenda      String?
  dateTime    DateTime
  duration    Int?     // in minutes
  location    String?
  meetingUrl  String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendees   Attendee[]
  research    Research[]
  brief       Brief?
  companyResearch CompanyResearch[]
}

model Attendee {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  role      String?
  company   String?
  linkedin  String?
  twitter   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   AttendeeProfile?
}

model AttendeeProfile {
  id            String   @id @default(cuid())
  attendeeId    String   @unique
  attendee      Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  currentRole   String?
  currentCompany String?
  previousRoles String?    // JSON string
  expertise     String   @default("[]") // JSON string
  notableProjects String?  // JSON string
  interests     String   @default("[]") // JSON string
  bio           String?
  avatarUrl     String?
  sources       String?    // JSON string
  lastUpdated   DateTime @default(now())
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  domain      String?  @unique
  description String?
  industry    String?
  size        String?
  founded     Int?
  headquarters String?
  website     String?
  linkedin    String?
  twitter     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  research    CompanyResearch[]
}

model CompanyResearch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  summary   String
  recentNews String?   // JSON string
  products  String?    // JSON string
  keyPeople String?    // JSON string
  insights  String?
  sources   String?    // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, meetingId])
}

model Research {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  type      String   // ATTENDEE, COMPANY, TOPIC, GENERAL
  query     String
  results   String   // JSON string
  status    String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, FAILED
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brief {
  id              String   @id @default(cuid())
  meetingId       String   @unique
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tldr            String   // JSON string
  attendeeSummaries String   // JSON string
  companyContext  String?    // JSON string
  topicBriefs     String?    // JSON string
  talkingPoints   String     // JSON string
  conversationStarters String // JSON string
  questions       String     // JSON string
  watchOuts       String?    // JSON string
  sources         String     // JSON string
  generatedAt     DateTime @default(now())
  version         Int      @default(1)
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique // for future auth
  ollamaModel   String   @default("qwen2.5-coder:7b")
  tavilyApiKey  String?
  defaultDuration Int    @default(60)
  timezone      String   @default("UTC")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}