generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  agenda      String?
  dateTime    DateTime
  duration    Int?
  location    String?
  meetingUrl  String?
  status      String   @default("DRAFT")
  // Host (meeting owner) — not researched as external attendee unless requested
  hostName    String?  // "You" by default
  hostEmail   String?
  hostId      String?  // future auth id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  attendees   Attendee[]
  research    Research[]
  brief       Brief?
  companyResearch CompanyResearch[]
  notifications Notification[]

  @@index([dateTime])
  @@index([title])
  @@index([status])
  @@index([createdAt])
}

model Attendee {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  role      String?
  company   String?
  linkedin  String?
  twitter   String?
  notes     String?
  // Intelligence platform fields
  github         String? // raw input github username/url
  githubUsername String? // normalized github handle
  confidence     String? @default("UNRESOLVED") // HIGH|MEDIUM|LOW|UNRESOLVED
  evidence       String? // JSON string: array of {fact, sourceUrl, sourceType, confidence, date}
  githubSnapshot String? // JSON string: GithubSnapshot
  lastResearched DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile   AttendeeProfile?

  @@index([name])
  @@index([company])
  @@index([meetingId])
}

model AttendeeProfile {
  id            String   @id @default(cuid())
  attendeeId    String   @unique
  attendee      Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  currentRole   String?
  currentCompany String?
  previousRoles String?
  expertise     String   @default("[]")
  notableProjects String?
  interests     String   @default("[]")
  bio           String?
  avatarUrl     String?
  sources       String?
  lastUpdated   DateTime @default(now())
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  domain      String?  @unique
  description String?
  industry    String?
  size        String?
  founded     Int?
  headquarters String?
  website     String?
  linkedin    String?
  twitter     String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  research    CompanyResearch[]
}

model CompanyResearch {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  summary   String
  recentNews String?
  products  String?
  keyPeople String?
  insights  String?
  sources   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, meetingId])
}

model Research {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  type      String
  query     String
  results   String
  status    String   @default("PENDING")
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Brief {
  id              String   @id @default(cuid())
  meetingId       String   @unique
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  tldr            String
  attendeeSummaries String
  companyContext  String?
  topicBriefs     String?
  talkingPoints   String
  conversationStarters String
  questions       String
  watchOuts       String?
  sources         String
  generatedAt     DateTime @default(now())
  version         Int      @default(1)
}

model UserSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  ollamaModel   String   @default("qwen2.5-coder:7b")
  tavilyApiKey  String?
  defaultDuration Int    @default(60)
  timezone      String   @default("UTC")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  type      String   // research_complete | meeting_reminder | research_failed | brief_updated | needs_confirmation
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([read])
  @@index([meetingId])
}

model CacheEntry {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   // JSON string
  expiresAt DateTime
  createdAt DateTime @default(now())
}
